[Unit]
Description=DeepSeek-V4-Flash-0731 DSpark vLLM (dual-node, head orchestrates worker)
Documentation=https://github.com/MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /etc/dspark-vllm/program.py --config /etc/dspark-vllm/config.yaml start
ExecStop=/usr/bin/python3 /etc/dspark-vllm/program.py --config /etc/dspark-vllm/config.yaml stop
Restart=on-failure
RestartSec=60
TimeoutStartSec=1800
TimeoutStopSec=600
KillMode=process

[Install]
WantedBy=multi-user.target
