[Unit]
Description=DeepSeek-V4-Flash-0731 DSpark vLLM worker container ensure
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /etc/dspark-vllm/program.py --config /etc/dspark-vllm/config.yaml ensure
Restart=on-failure
RestartSec=60
TimeoutStartSec=1200
KillMode=process

[Install]
WantedBy=multi-user.target
