# =============================================================================
# DeepSeek V4 Flash DSpark – 2x DGX Spark TP=2 配置模板（脱敏）
# 用法：在 head 节点仓库目录执行 cp .env.dspark.example .env.dspark
#       然后按 VARIABLES.md 替换 <占位符>
# 注意：NCCL 参数按“线实际插的物理口”逐台填写，head/worker 可以不同；
#       启动脚本 start-deepseek-v4-flash-dspark.sh 会自动把 WORKER_* 注入 worker。
# =============================================================================

# ---- 集群 ----
WORKER_HOST=<IP_MGMT_B>            # head 用来 SSH worker 的地址
WORKER_DIR=                        # 留空 = 与 head 相同路径
WORKER_SCRIPT_DIR=
MASTER_ADDR=<IP_FABRIC_A>          # head 的集群网 IP
MASTER_PORT=25000
NODE_RANK=0                        # head 固定为 0；worker 由启动脚本设为 1
HEADLESS=

# ---- head 的 RoCE（以实际插线口为准，可用 ibdev2netdev 查看）----
NCCL_IB_HCA=<NCCL_HCA_A>
NCCL_SOCKET_IFNAME=<NCCL_IF_A>
TP_SOCKET_IFNAME=<NCCL_IF_A>
GLOO_SOCKET_IFNAME=<NCCL_IF_A>
# ---- worker 的 RoCE（可不同于 head）----
WORKER_NCCL_IB_HCA=<NCCL_HCA_B>
WORKER_NCCL_SOCKET_IFNAME=<NCCL_IF_B>
WORKER_TP_SOCKET_IFNAME=<NCCL_IF_B>
WORKER_GLOO_SOCKET_IFNAME=<NCCL_IF_B>
NCCL_CROSS_NIC=1

# ---- 模型缓存 ----
HF_CACHE=${HOME}/.cache/huggingface
WORKER_HF_CACHE=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
# 检查点开关：0=官方 0731，1=Keys abliterated（start 脚本据此解析 DSPARK_MODEL，勿再直接设 DSPARK_MODEL）
ABLITERATED=0
# 官方 0731 模型路径（容器内路径；本地 156G 模型不经 HF hub，勿用 hub id）
DSPARK_MODEL_OFFICIAL=/cache/huggingface/models/<HF_MODEL_SHORT>
DSPARK_ENCODING_FILE=/cache/huggingface/models/<HF_MODEL_SHORT>/encoding/encoding_dsv4.py
# 官方 revision pin：留空 = 脚本自动 pin 实测过的 9e165c30…（Issue #19）；显式空值 = 不 pin
# DSPARK_REVISION=
SERVED_MODEL_NAME=deepseek-v4-flash-0731
VLLM_HOST=0.0.0.0                  # 0.0.0.0 供局域网其他机器访问；仅本机测试可改 127.0.0.1
VLLM_PORT=8888
VLLM_HOST_IP=<IP_FABRIC_A>
WORKER_VLLM_HOST_IP=<IP_FABRIC_B>

# ---- 运行时镜像 ----
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1

# ---- 服务 profile ----
# 视觉模式开关：0=text-only（默认，util 用 TEXT，KV 池更大）；1=VL sidecar 实验路径（util 用 VISION）
ENABLE_VL_SIDECAR=0
MAX_MODEL_LEN=1048576              # 1M 上下文
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
# 新版不再用 GPU_MEMORY_UTILIZATION，按 ENABLE_VL_SIDECAR 二选一（start 脚本自动 export）
GPU_MEMORY_UTILIZATION_TEXT=0.835  # text-only 默认（实测 KV 池 ≈230 万 token，双机 17.02+16.64 GiB）
# GPU_MEMORY_UTILIZATION_VISION=0.80
MTP_NUM_TOKENS=5                   # DSpark 草稿块，必须 >= 检查点 dspark_block_size(5)
DEFAULT_THINKING=max               # off/low/high/max；压测建议改 low/off
# Issue #22 hotfix（nvfp4_ds_mla 长上下文解码修复）随 start 自动应用；设 1 跳过
# DSPARK_SKIP_HOTFIX=0

# ---- vLLM / b12x / GB10 调优参数（Anemll 镜像可用）----
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc

# ---- NCCL ----
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

